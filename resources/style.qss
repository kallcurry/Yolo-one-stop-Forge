}

QLabel#trainingTaskStatusBadge[tone="info"],
QLabel#trainingTaskStatusBadge[tone="running"] {
    background-color: rgba(54, 183, 255, 22);
    color: #72DAFF;
    border-color: rgba(54, 183, 255, 108);
}

QLabel#trainingTaskStatusBadge[tone="success"] {
    background-color: rgba(69, 212, 131, 23);
    color: #69E6A2;
    border-color: rgba(69, 212, 131, 112);
}

QLabel#trainingTaskStatusBadge[tone="warning"] {
    background-color: rgba(245, 185, 66, 22);
    color: #F6CB64;
    border-color: rgba(245, 185, 66, 108);
}

QLabel#trainingTaskStatusBadge[tone="danger"] {
    background-color: rgba(255, 87, 99, 22);
    color: #FF8792;
    border-color: rgba(255, 87, 99, 112);
}

QProgressBar#trainingTaskProgress {
    background-color: rgba(3, 11, 18, 226);
    color: #DDF6FF;
    border: 1px solid rgba(98, 232, 255, 48);
    border-radius: 6px;
    min-height: 23px;
    text-align: center;
    font-size: 9px;
    font-weight: 800;
}

QProgressBar#trainingTaskProgress::chunk {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #2298CD,
        stop: 1 #38C886
    );
    border-radius: 5px;
}

QPlainTextEdit#trainingTaskNotes {
    background-color: rgba(3, 11, 18, 222);
    color: #CFE3EE;
    border: 1px solid rgba(111, 151, 184, 54);
    border-radius: 6px;
    padding: 6px;
    font-size: 9px;
}

QPushButton#trainingTaskActionBtn {
    min-height: 27px;
    padding: 3px 7px;
    background-color: rgba(22, 42, 57, 216);
    color: #BFD8E7;
    border: 1px solid rgba(111, 151, 184, 72);
    border-radius: 6px;
    font-size: 9px;
    font-weight: 800;
}

QPushButton#trainingTaskActionBtn:hover {
    background-color: rgba(25, 77, 100, 226);
    color: #F3FCFF;
    border-color: rgba(98, 232, 255, 132);
}

QPushButton#trainingTaskActionBtn[danger="true"] {
    color: #FF929B;
    border-color: rgba(255, 102, 119, 74);
}

QPushButton#trainingTaskActionBtn[danger="true"]:hover {
    background-color: rgba(119, 30, 43, 198);
    border-color: rgba(255, 102, 119, 158);
}

QSplitter#trainingTaskSplitter::handle:horizontal {
    background-color: rgba(20, 45, 59, 220);
    border-left: 1px solid rgba(98, 232, 255, 38);
    border-right: 1px solid rgba(98, 232, 255, 38);
    border-radius: 3px;
    width: 7px;
    margin: 8px 1px;
}

QSplitter#trainingTaskSplitter::handle:horizontal:hover {
    background-color: rgba(54, 183, 255, 110);
    border-color: rgba(98, 232, 255, 142);
}

QWidget#trainingSetupPanel,
QWidget#trainingSourcePanel,
QWidget#trainingReviewStatusPanel,
QWidget#trainingMonitorEmpty {
    background-color: rgba(7, 17, 26, 214);
    border: 1px solid rgba(111, 151, 184, 62);
    border-radius: 8px;
}

QStackedWidget#trainingSourceStack {
    background-color: transparent;
    border: none;
}

QComboBox#trainingCombo,
QLineEdit#trainingPathEdit,
QLineEdit#trainingEdit,
QSpinBox#trainingSpin,
QDoubleSpinBox#trainingSpin {
    background-color: rgba(7, 18, 28, 228);
    color: #DCECF6;
    border: 1px solid rgba(111, 151, 184, 94);
    border-radius: 7px;
    padding: 5px 9px;
    min-height: 25px;
}

QComboBox#trainingCombo:hover,
QComboBox#trainingCombo:focus,
QLineEdit#trainingPathEdit:focus,
QLineEdit#trainingEdit:focus,
QSpinBox#trainingSpin:focus,
QDoubleSpinBox#trainingSpin:focus {
    border-color: rgba(98, 232, 255, 184);
}

QTreeWidget#trainingSourceTree,
QTreeWidget#trainingBatchSummaryTree {
    background-color: rgba(4, 13, 21, 202);
    border: 1px solid rgba(98, 232, 255, 36);
    border-radius: 7px;
    padding: 2px;
}

QTreeWidget#trainingSourceTree::item,
QTreeWidget#trainingBatchSummaryTree::item {
    min-height: 27px;
    padding: 2px 5px;
}

QTreeWidget#trainingSourceTree::item:hover {
    background-color: rgba(54, 183, 255, 25);
    color: #FFFFFF;
}

QPushButton#trainingOptionBtn {
    background-color: rgba(20, 35, 47, 210);
    color: #AFC2D0;
    border: 1px solid rgba(111, 151, 184, 82);
    border-radius: 7px;
    padding: 5px 10px;
}

QPushButton#trainingOptionBtn:checked {
    background-color: rgba(34, 117, 89, 190);
    color: #DFFFF0;
    border-color: rgba(69, 212, 131, 150);
}

QToolButton#trainingIconBtn {
    background-color: rgba(12, 31, 45, 226);
    color: #7DDEFF;
    border: 1px solid rgba(98, 232, 255, 76);
    border-radius: 7px;
    font-size: 16px;
}

QToolButton#trainingIconBtn:hover {
    background-color: rgba(25, 73, 96, 228);
    color: #FFFFFF;
    border-color: #62E8FF;
}

QLabel#trainingSourceSummary,
QLabel#trainingPreparationState,
QLabel#trainingReviewPath {
    background-color: transparent;
    color: #9CB3C2;
    border: none;
}

QProgressBar#trainingPreparationProgress {
    background-color: rgba(5, 13, 21, 214);
    border: 1px solid rgba(111, 151, 184, 48);
    border-radius: 4px;
    min-height: 7px;
    max-height: 7px;
}

QProgressBar#trainingPreparationProgress::chunk {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #36B7FF,
        stop: 1 #45D483
    );
    border-radius: 3px;
}

QLabel#trainingReviewStatus {
    background-color: transparent;
    color: #F5A524;
    border: none;
    font-size: 15px;
    font-weight: 900;
}

QLabel#trainingReviewStatus[ready="true"] {
    color: #57E397;
}

QLabel#trainingEmptyCode {
    background-color: rgba(54, 183, 255, 14);
    color: #62E8FF;
    border: 1px solid rgba(54, 183, 255, 48);
    border-radius: 7px;
    padding: 9px 16px;
    font-size: 10px;
    font-weight: 900;
}

QLabel#trainingEmptyTitle {
    background-color: transparent;
    color: #AFC2D0;
    border: none;
    font-size: 13px;
    font-weight: 700;
}

/* Training data library and configuration cockpit */
QSplitter#trainingDataSourceSplitter::handle:horizontal {
    background-color: rgba(16, 42, 56, 220);
    border-left: 1px solid rgba(98, 232, 255, 42);
    border-right: 1px solid rgba(98, 232, 255, 42);
    border-radius: 3px;
    width: 7px;
    margin: 12px 1px;
}

QSplitter#trainingDataSourceSplitter::handle:horizontal:hover {
    background-color: rgba(54, 183, 255, 118);
    border-color: rgba(98, 232, 255, 154);
}

QLabel#trainingPanelTitle,
QLabel#trainingParameterTitle {
    background-color: transparent;
    color: #EAF7FC;
    border: none;
    font-size: 12px;
    font-weight: 900;
}

QLabel#trainingPanelBadge {
    background-color: rgba(54, 183, 255, 15);
    color: #77DCFF;
    border: 1px solid rgba(54, 183, 255, 58);
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 9px;
    font-weight: 800;
}

QToolButton#trainingBatchSelectionBtn {
    background-color: rgba(23, 51, 66, 176);
    color: #A9D7E8;
    border: 1px solid rgba(98, 232, 255, 62);
    border-radius: 6px;
    padding: 4px 9px;
    min-width: 36px;
    font-size: 9px;
    font-weight: 800;
}

QToolButton#trainingBatchSelectionBtn:hover {
    background-color: rgba(38, 101, 128, 196);
    color: #FFFFFF;
    border-color: rgba(98, 232, 255, 166);
}

QToolButton#trainingBatchSelectionBtn:pressed {
    background-color: rgba(24, 73, 94, 220);
}

QLabel#trainingStatusBadge {
    background-color: rgba(111, 151, 184, 16);
    color: #9FB4C3;
    border: 1px solid rgba(111, 151, 184, 52);
    border-radius: 5px;
    padding: 2px 7px;
    margin: 3px 4px;
    min-width: 38px;
    font-size: 9px;
    font-weight: 900;
}

QLabel#trainingStatusBadge[tone="success"] {
    background-color: rgba(69, 212, 131, 26);
    color: #65E6A0;
    border-color: rgba(69, 212, 131, 104);
}

QLabel#trainingStatusBadge[tone="warning"] {
    background-color: rgba(245, 185, 66, 24);
    color: #F7C95B;
    border-color: rgba(245, 185, 66, 100);
}

QLabel#trainingStatusBadge[tone="danger"] {
    background-color: rgba(255, 87, 99, 24);
    color: #FF737C;
    border-color: rgba(255, 87, 99, 104);
}

QTreeWidget#trainingExistingBatchTree {
    background-color: rgba(4, 13, 21, 206);
    border: 1px solid rgba(98, 232, 255, 36);
    border-radius: 7px;
    padding: 2px;
    selection-background-color: rgba(34, 117, 150, 174);
    selection-color: #FFFFFF;
}

QTreeWidget#trainingExistingBatchTree::item {
    min-height: 29px;
    padding: 3px 5px;
    border-bottom: 1px solid rgba(111, 151, 184, 18);
}

QTreeWidget#trainingExistingBatchTree::item:hover {
    background-color: rgba(41, 79, 98, 116);
}

QWidget#trainingTemplateBar {
    background-color: rgba(8, 22, 33, 224);
    border: 1px solid rgba(98, 232, 255, 52);
    border-radius: 8px;
}

QComboBox#trainingTemplateCombo {
    background-color: rgba(5, 15, 24, 232);
    color: #DDF4FC;
    border: 1px solid rgba(111, 151, 184, 96);
    border-radius: 7px;
    padding: 5px 10px;
    min-height: 25px;
}

QComboBox#trainingTemplateCombo:hover,
QComboBox#trainingTemplateCombo:focus {
    border-color: rgba(98, 232, 255, 180);
}

QPushButton#trainingAdvancedBtn {
    background-color: rgba(43, 95, 116, 118);
    color: #C9F3FF;
    border: 1px solid rgba(98, 232, 255, 104);
    border-radius: 7px;
    padding: 6px 13px;
    font-weight: 800;
}

QPushButton#trainingAdvancedBtn:hover {
    background-color: rgba(37, 132, 158, 184);
    color: #FFFFFF;
    border-color: #62E8FF;
}

QWidget#trainingDatasetContext {
    background-color: rgba(13, 37, 48, 214);
    border: 1px solid rgba(69, 212, 131, 70);
    border-radius: 8px;
}

QLabel#trainingConfigCaption {
    background-color: transparent;
    color: #70DCA0;
    border: none;
    font-size: 9px;
    font-weight: 900;
}

QLabel#trainingConfigDatasetName {
    background-color: transparent;
    color: #F0FAFF;
    border: none;
    font-size: 13px;
    font-weight: 900;
}

QLabel#trainingConfigDatasetMeta {
    background-color: transparent;
    color: #91AABB;
    border: none;
    font-size: 10px;
}

QScrollArea#trainingConfigScroll,
QWidget#trainingConfigBody {
    background-color: transparent;
    border: none;
}

QWidget#trainingParameterPanel {
    background-color: rgba(7, 17, 26, 218);
    border: 1px solid rgba(111, 151, 184, 58);
    border-radius: 8px;
}

QSpinBox#trainingParamSpin,
QDoubleSpinBox#trainingParamSpin {
    background-color: rgba(5, 15, 24, 232);
    color: #DCECF6;
    border: 1px solid rgba(111, 151, 184, 88);
    border-radius: 6px;
    padding: 4px 7px;
    min-height: 24px;
    min-width: 72px;
}

QSpinBox#trainingParamSpin:focus,
QDoubleSpinBox#trainingParamSpin:focus {
    border-color: rgba(98, 232, 255, 178);
}

QCheckBox#trainingToggle {
    color: #AFC4D2;
    spacing: 6px;
    padding: 5px 7px;
}

QCheckBox#trainingToggle:hover {
    color: #EAF9FF;
    background-color: rgba(54, 183, 255, 14);
    border-radius: 5px;
}

QCheckBox#trainingToggle::indicator {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 1px solid rgba(111, 151, 184, 128);
    background-color: rgba(5, 14, 22, 230);
}

QCheckBox#trainingToggle::indicator:checked {
    background-color: #2FBD82;
    border-color: #73E7A8;
}

QDialog#trainingTemplateDialog {
    background-color: #09131D;
}

QLabel#trainingDialogEyebrow {
    background-color: transparent;
    color: #62E8FF;
    border: none;
    font-size: 9px;
    font-weight: 900;
}

QLabel#trainingDialogTitle {
    background-color: transparent;
    color: #F1FAFF;
    border: none;
    font-size: 20px;
    font-weight: 900;
}

QLabel#trainingDialogTaskBadge {
    background-color: rgba(69, 212, 131, 18);
    color: #83E6AE;
    border: 1px solid rgba(69, 212, 131, 86);
    border-radius: 7px;
    padding: 7px 12px;
    font-weight: 900;
}

QPlainTextEdit#trainingTemplateEditor {
    background-color: rgba(4, 12, 20, 238);
    color: #D8ECF7;
    border: 1px solid rgba(98, 232, 255, 56);
    border-radius: 8px;
    padding: 10px;
    selection-background-color: rgba(35, 133, 175, 190);
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 11px;
}

QLabel#trainingDialogStatus {
    background-color: rgba(54, 183, 255, 12);
    color: #90B4C8;
    border: 1px solid rgba(54, 183, 255, 32);
    border-radius: 6px;
    padding: 6px 9px;
}

/* Live Ultralytics run monitor */
QLabel#trainingRunStatus {
    background-color: rgba(111, 151, 184, 18);
    color: #9DB2C2;
    border: 1px solid rgba(111, 151, 184, 62);
    border-radius: 6px;
    padding: 5px 10px;
    min-width: 64px;
    font-size: 9px;
    font-weight: 900;
}

QLabel#trainingRunStatus[tone="running"] {
    background-color: rgba(54, 183, 255, 22);
    color: #74DCFF;
    border-color: rgba(54, 183, 255, 112);
}

QLabel#trainingRunStatus[tone="success"] {
    background-color: rgba(69, 212, 131, 24);
    color: #69E6A2;
    border-color: rgba(69, 212, 131, 112);
}

QLabel#trainingRunStatus[tone="warning"] {
    background-color: rgba(245, 185, 66, 24);
    color: #F7CA5D;
    border-color: rgba(245, 185, 66, 108);
}

QLabel#trainingRunStatus[tone="danger"] {
    background-color: rgba(255, 87, 99, 24);
    color: #FF737C;
    border-color: rgba(255, 87, 99, 112);
}

QWidget#trainingRunContext,
QWidget#trainingMetricCard,
QWidget#trainingMonitorPanel {
    background-color: rgba(6, 16, 25, 218);
    border: 1px solid rgba(111, 151, 184, 54);
    border-radius: 8px;
}

QWidget#trainingMetricCard {
    background-color: rgba(10, 29, 41, 218);
    border-color: rgba(98, 232, 255, 46);
}

QLabel#trainingRunPrimary {
    background-color: transparent;
    color: #EFFAFF;
    border: none;
    font-size: 12px;
    font-weight: 900;
}

QLabel#trainingRunPath {
    background-color: transparent;
    color: #85A7BA;
    border: none;
    font-size: 10px;
}

QLabel#trainingMetricCaption {
    background-color: transparent;
    color: #7897AA;
    border: none;
    font-size: 8px;
    font-weight: 800;
}

QLabel#trainingMetricValue {
    background-color: transparent;
    color: #EAF8FF;
    border: none;
    font-size: 13px;
    font-weight: 900;
}

QProgressBar#trainingRunProgress {
    background-color: rgba(5, 13, 21, 224);
    color: #DDF6FF;
    border: 1px solid rgba(98, 232, 255, 58);
    border-radius: 7px;
    min-height: 24px;
    text-align: center;
    font-size: 9px;
    font-weight: 900;
}

QProgressBar#trainingRunProgress::chunk {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #259DD2,
        stop: 1 #35C985
    );
    border-radius: 6px;
}

QTreeWidget#trainingMetricTree,
QPlainTextEdit#trainingLog {
    background-color: rgba(3, 11, 18, 226);
    color: #CFE3EE;
    border: 1px solid rgba(98, 232, 255, 34);
    border-radius: 7px;
    selection-background-color: rgba(35, 119, 153, 178);
}

QComboBox#trainingMetricGroupCombo {
    min-width: 126px;
    min-height: 27px;
    padding: 2px 28px 2px 10px;
    background-color: rgba(10, 29, 41, 232);
    color: #DDF6FF;
    border: 1px solid rgba(98, 232, 255, 62);
    border-radius: 6px;
    font-size: 9px;
    font-weight: 800;
}

QComboBox#trainingMetricGroupCombo:hover,
QComboBox#trainingMetricGroupCombo:focus {
    background-color: rgba(13, 39, 54, 240);
    border-color: rgba(98, 232, 255, 142);
}

QTabWidget#trainingMetricTabs::pane {
    background-color: transparent;
    border: 1px solid rgba(98, 232, 255, 34);
    border-radius: 7px;
    top: -1px;
}

QTabWidget#trainingMetricTabs QTabBar::tab {
    min-width: 72px;
    min-height: 25px;
    padding: 2px 10px;
    margin-right: 4px;
    background-color: rgba(7, 20, 30, 218);
    color: #7897AA;
    border: 1px solid rgba(98, 232, 255, 30);
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-size: 9px;
    font-weight: 800;
}

QTabWidget#trainingMetricTabs QTabBar::tab:selected {
    background-color: rgba(24, 100, 131, 210);
    color: #F0FAFF;
    border-color: rgba(98, 232, 255, 112);
}

QWidget#trainingCurveChart {
    background-color: rgba(3, 11, 18, 226);
    border: none;
    border-radius: 6px;
}

QTreeWidget#trainingMetricTree::item {
    min-height: 27px;
    padding: 2px 5px;
    border-bottom: 1px solid rgba(111, 151, 184, 16);
}

QPlainTextEdit#trainingLog {
    padding: 8px;
    color: #AFC9D8;
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 10px;
}

QSplitter#trainingMonitorSplitter::handle:horizontal {
    background-color: rgba(20, 45, 59, 220);
    border-left: 1px solid rgba(98, 232, 255, 38);
    border-right: 1px solid rgba(98, 232, 255, 38);
    border-radius: 3px;
    width: 7px;
    margin: 8px 1px;
}

QSplitter#trainingMonitorSplitter::handle:horizontal:hover {
    background-color: rgba(54, 183, 255, 110);
    border-color: rgba(98, 232, 255, 142);
}
