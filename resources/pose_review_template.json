{
  "name": "ShengSong Pose 23点审查模板",
  "version": 1,
  "description": "导入此 JSON 后，Qt 界面的 Pose 审查、骨架线和关键点重排序都会按这里的配置执行。",
  "task_type": "pose",
  "annotation_dir": "annotations",
  "target_classes": [
    "person_dress_finish",
    "person_dress_middle",
    "person_dress_never",
    "climbing_tower"
  ],
  "keypoints": [
    "top_helmet",
    "left_helmet",
    "right_helmet",
    "nose",
    "jaw",
    "left_shoulder",
    "right_shoulder",
    "left_elbow",
    "right_elbow",
    "left_wrist",
    "right_wrist",
    "left_shoulder_strap",
    "right_shoulder_strap",
    "left_waist",
    "right_waist",
    "left_hip",
    "right_hip",
    "left_thigh",
    "right_thigh",
    "left_knee",
    "right_knee",
    "left_ankle",
    "right_ankle"
  ],
  "kpt_connections": [
    [0, 1],
    [0, 2],
    [1, 3],
    [2, 3],
    [3, 4],
    [4, 5],
    [4, 6],
    [5, 7],
    [6, 8],
    [7, 9],
    [8, 10],
    [5, 11],
    [6, 12],
    [11, 12],
    [11, 13],
    [12, 14],
    [13, 14],
    [13, 15],
    [14, 16],
    [15, 17],
    [16, 18],
    [17, 19],
    [18, 20],
    [19, 21],
    [20, 22]
  ],
  "left_right_pairs": [
    ["left_shoulder", "right_shoulder"],
    ["left_elbow", "right_elbow"],
    ["left_wrist", "right_wrist"],
    ["left_waist", "right_waist"],
    ["left_hip", "right_hip"],
    ["left_thigh", "right_thigh"],
    ["left_knee", "right_knee"],
    ["left_ankle", "right_ankle"]
  ],
  "rules": {
    "duplicate_keypoint": true,
    "suspected_left_right_swap": true,
    "missing_person_box": true,
    "keypoint_outside_box": true,
    "keypoint_wrong_person": true,
    "group_id_missing": true,
    "group_id_conflict": true,
    "image_size_missing": true,
    "image_size_mismatch": true
  },
  "custom_rules": [],
  "thresholds": {
    "box_margin_min": 4.0,
    "box_margin_ratio": 0.02,
    "left_right_min_points": 6,
    "left_right_margin_min": 12.0,
    "left_right_margin_ratio": 0.04,
    "left_right_score_ratio": 1.35
  },
  "field_tips": {
    "task_type": "任务类型，例如 pose、detection、segmentation、obb。",
    "annotation_dir": "当前任务使用的 X-AnyLabeling JSON 标注目录名称。",
    "target_classes": "哪些 rectangle 标签被视为人的框。",
    "keypoints": "关键点标准顺序；重排序功能会按这个顺序排列。",
    "kpt_connections": "骨架线连接关系，可写索引，也可写关键点名称。",
    "left_right_pairs": "左右反标检查用的成对关键点。",
    "rules": "内置规则开关；未知规则会提示未执行。",
    "custom_rules": "参数化规则或 Python 插件规则。常用 type: required_keypoints, forbidden_keypoints, paired_keypoints, relative_position, distance_range, python。",
    "thresholds": "几何检查的容忍阈值。"
  }
}
