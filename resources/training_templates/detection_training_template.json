{
  "name": "内置 Detection 稳定训练模板",
  "version": 1,
  "description": "适用于 Ultralytics 目标检测任务的基础训练配置。",
  "task_type": "detection",
  "model": "yolov8n.pt",
  "parameters": {
    "epochs": 100,
    "patience": 100,
    "batch": 16,
    "imgsz": 640,
    "device": "0",
    "workers": 8,
    "optimizer": "auto",
    "lr0": 0.01,
    "lrf": 0.01,
    "momentum": 0.937,
    "weight_decay": 0.0005,
    "warmup_epochs": 3.0,
    "warmup_momentum": 0.8,
    "warmup_bias_lr": 0.1,
    "amp": true,
    "cache": false,
    "pretrained": true,
    "seed": 0,
    "deterministic": true,
    "cos_lr": false,
    "close_mosaic": 10,
    "multi_scale": 0.0,
    "rect": false,
    "save": true,
    "save_period": -1,
    "plots": true,
    "val": true,
    "box": 7.5,
    "cls": 0.5,
    "dfl": 1.5,
    "hsv_h": 0.015,
    "hsv_s": 0.7,
    "hsv_v": 0.4,
    "degrees": 0.0,
    "translate": 0.1,
    "scale": 0.5,
    "shear": 0.0,
    "perspective": 0.0,
    "flipud": 0.0,
    "fliplr": 0.5,
    "mosaic": 1.0,
    "mixup": 0.0,
    "cutmix": 0.0
  },
  "ultralytics_version": "8.4.115"
}
