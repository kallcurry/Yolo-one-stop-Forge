# Copy this file to deployment/local.env only when X-AnyLabeling lives in a
# different Python environment. Environment names are deliberately not used.

# Preferred: point directly at that environment's Python interpreter.
# export VISION_PLATFORM_XANYLABELING_PYTHON="$HOME/miniconda3/envs/labeling/bin/python"

# Alternative: point at the xanylabeling executable.
# export VISION_PLATFORM_XANYLABELING="$HOME/miniconda3/envs/labeling/bin/xanylabeling"
